; POC de realidad aumentada sobre mesa, Godot 4.x.

config_version=5

[application]

config/name="Tabletop AR POC"
config/icon="res://assets/app_icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.web=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.055, 1)

[debug]

gdscript/warnings/untyped_declaration=1
