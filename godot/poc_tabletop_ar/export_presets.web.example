[preset.0]

name="Web Preview"
platform="Web"
runnable=true
advanced_options=true
dedicated_server=false
custom_features="web_preview"
export_filter="all_resources"
include_filter="assets/environment/island_biome/world/*.bin"
exclude_filter="addons/GodotApplePluginsARKit/*,addons/GodotApplePluginsRuntime/*,art/*,previews/*,exports/*,tools/*,tests/*,assets/environment/island_biome/source/*,assets/environment/island_biome/palms/source/*,assets/units/source/*,assets/units/human_base*,assets/units/textures/*,assets/environment/island_biome/*_report.json,assets/environment/island_biome/world/*_report.json,assets/environment/island_biome/textures/palms/*_report.json,assets/environment/island_biome/textures/ground_grass_*,assets/environment/island_biome/textures/ground_soil_*,assets/environment/island_biome/textures/ground_sand_albedo.png,assets/environment/island_biome/textures/ground_sand_roughness.png,assets/environment/island_biome/world/*.exr"
export_path="exports/web-preview/index.html"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release=""
variant/extensions_support=false
variant/thread_support=false
vram_texture_compression/for_desktop=true
vram_texture_compression/for_mobile=true
html/export_icon=true
html/custom_html_shell="res://web/aoe_ar_shell.html"
html/head_include=""
html/canvas_resize_policy=2
html/focus_canvas_on_start=true
html/experimental_virtual_keyboard=true
progressive_web_app/enabled=false
progressive_web_app/ensure_cross_origin_isolation_headers=false
progressive_web_app/offline_page=""
progressive_web_app/display=0
progressive_web_app/orientation=1
progressive_web_app/icon_144x144=""
progressive_web_app/icon_180x180=""
progressive_web_app/icon_512x512=""
progressive_web_app/background_color=Color(0.025, 0.035, 0.055, 1)
